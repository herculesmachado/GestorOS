@model List<CategoriaServicos>
@{
    ViewData["Title"] = "Categorias de Serviço";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-tags me-2"></i>Categorias de Serviço</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>Nova Categoria</a>
</div>

<div class="card p-3">
    @if (!Model.Any())
    {
        <p class="text-muted mb-0">Nenhuma categoria cadastrada.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Descrição</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Nome</td>
                            <td>@(c.Descricao ?? "-")</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                                <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>